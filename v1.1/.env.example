# Existing process environment takes precedence. Then v1.1/.env,
# repository .env, repository backend/.env (fallback only).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
# Optional provider-specific setting; omitted unless explicitly set.
# LLM_THINKING=off
FIN_ALLOWED_COMPANIES=1000,2000
FIN_SQL_TIMEOUT=5
