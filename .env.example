# ===== LLM 配置（OpenAI 兼容接口，任选其一）=====
# DeepSeek（示例）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-你的key
LLM_MODEL=deepseek-v4-flash

# Kimi（月之暗面）
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_API_KEY=sk-你的key
# LLM_MODEL=kimi-k2.5

# 通义千问（DashScope 兼容模式）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-你的key
# LLM_MODEL=qwen-plus

# ===== 可选参数（默认值已标注，一般无需修改）=====
# LLM_TIMEOUT=120            # 单次调用超时（秒）
# LLM_MAX_RETRIES=3          # 调用失败重试次数
# LLM_TRANSPORT=auto         # auto | requests | curl（受限网络可强制 curl）
# IC_SQL_MAX_REPAIR=3        # SQL 自我修正最大轮数
# IC_SQL_ROW_LIMIT=500       # 查询结果行数上限
# IC_SQL_TIMEOUT_S=10        # 单条 SQL 执行超时（秒）
